# ---------------------------------------------------------------------------
# Backend environment template -> copy to backend/.env
# NEVER put real API keys in version control.
# ---------------------------------------------------------------------------

# Origins allowed to call this API (comma separated)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# AI Provider Configuration:
# - AI_PROVIDER: 'gemini' (default & recommended), 'openai', or 'mock' (offline test provider).
# - Setting AI_PROVIDER=mock allows testing the full AI pipeline offline without an API key!
# - For Google Gemini:
#     Put your Gemini API key in AI_API_KEY (or GEMINI_API_KEY).
#     AI_PROVIDER=gemini
#     AI_API_KEY=your_gemini_api_key_here
#     AI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
#     AI_MODEL=gemini-2.0-flash
#     AI_TIMEOUT_SECONDS=20
# - For OpenAI:
#     AI_PROVIDER=openai
#     AI_API_KEY=your_openai_api_key_here
#     AI_BASE_URL=https://api.openai.com/v1
#     AI_MODEL=gpt-4o-mini
#     AI_TIMEOUT_SECONDS=20
# - If AI_API_KEY is empty, the app falls back silently to the deterministic Smart planner.
# Note: LLM_* prefixes (e.g. LLM_API_KEY) and GEMINI_API_KEY are also supported.
AI_PROVIDER=gemini
AI_API_KEY=
AI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
AI_MODEL=gemini-2.0-flash
AI_TIMEOUT_SECONDS=20
