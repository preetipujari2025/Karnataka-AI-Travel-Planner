# ---------------------------------------------------------------------------
# Backend environment template -> copy to backend/.env
# NEVER put real API keys in version control.
# ---------------------------------------------------------------------------

# Origins allowed to call this API (comma separated)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# AI Provider Configuration:
# - AI_PROVIDER: 'openai' (default), 'gemini', or 'mock' (offline test provider)
# - Setting AI_PROVIDER=mock allows testing the full AI pipeline without an API key!
# - For real providers, set AI_API_KEY. If empty, the app falls back to the deterministic planner.
# Note: LLM_* prefixes (e.g. LLM_API_KEY) are also supported for backwards compatibility.
AI_PROVIDER=openai
AI_API_KEY=
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4o-mini
AI_TIMEOUT_SECONDS=30
