# ---------------------------------------------------------------------------
# Root environment template.
# Copy to `.env` (root) and adjust. NEVER commit real values.
# Each app also has its own template: backend/.env.example, frontend/.env.example
# ---------------------------------------------------------------------------

# --- Backend (FastAPI) -----------------------------------------------------
# Comma separated list of allowed frontend origins (local dev)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Configurable AI endpoint used for AI itinerary personalization.
# Supported providers: 'openai' (default), 'gemini', or 'mock' (offline test provider).
# Setting AI_PROVIDER=mock allows testing the full AI pipeline without an API key!
# If AI_API_KEY is empty, the API falls back to the deterministic planner.
# Note: LLM_* prefixes (e.g. LLM_API_KEY) are also supported for backwards compatibility.
AI_PROVIDER=openai
AI_API_KEY=
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4o-mini
AI_TIMEOUT_SECONDS=30

# --- Frontend (Vite) -------------------------------------------------------
# Vite only exposes variables prefixed with VITE_
# Backend base URL used by the React app
VITE_API_BASE_URL=http://localhost:8000
