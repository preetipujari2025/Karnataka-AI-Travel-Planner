# ---------------------------------------------------------------------------
# Root environment template.
# Copy to `.env` (root) and adjust. NEVER commit real values.
# Each app also has its own template: backend/.env.example, frontend/.env.example
# ---------------------------------------------------------------------------

# --- Backend (FastAPI) -----------------------------------------------------
# Comma separated list of allowed frontend origins (local dev)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Configurable AI endpoint used for AI itinerary personalization.
# Supported providers: 'gemini' (default & recommended), 'openai', or 'mock' (offline test provider).
# Setting AI_PROVIDER=mock allows testing the full AI pipeline offline without an API key!
# For Google Gemini:
#   AI_PROVIDER=gemini
#   AI_API_KEY=your_gemini_api_key_here  (or GEMINI_API_KEY)
#   AI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
#   AI_MODEL=gemini-1.5-flash
#   AI_TIMEOUT_SECONDS=20
# If AI_API_KEY is empty, the API falls back silently to the deterministic Smart planner.
AI_PROVIDER=gemini
AI_API_KEY=
AI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
AI_MODEL=gemini-2.0-flash
AI_TIMEOUT_SECONDS=20

# --- Frontend (Vite) -------------------------------------------------------
# Vite only exposes variables prefixed with VITE_
# Backend base URL used by the React app
VITE_API_BASE_URL=http://localhost:8000
